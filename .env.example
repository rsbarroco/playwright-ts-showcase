# Copy to .env or export in your shell. Never commit real values.
# Selects config/<TEST_ENV>.yaml on top of config/default.yaml
TEST_ENV=default
# Credentials shown on https://the-internet.herokuapp.com/login
UI_USERNAME=<username>
UI_PASSWORD=<password>
# Optional overrides
# UI_BASE_URL=https://the-internet.herokuapp.com
# API_BASE_URL=https://jsonplaceholder.typicode.com
